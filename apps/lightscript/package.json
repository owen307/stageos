{
  "name": "lightscript",
  "version": "1.0.0",
  "description": "LightScript \u2014 Scriptable Lighting Console",
  "main": "main.js",
  "scripts": {
    "start":       "electron .",
    "obfuscate":   "node obfuscate.js",
    "build-win":   "npm run obfuscate && electron-builder --win",
    "build-mac":   "npm run obfuscate && electron-builder --mac",
    "build-linux": "npm run obfuscate && electron-builder --linux",
    "build-dev":   "electron-builder --win"
  },
  "build": {
    "appId": "com.lightscript.app",
    "icon": "assets/icon.png",
    "files": [
      "**/*",
      "!license-gen.js",
      "!license-*.txt",
      "!obfuscate.js",
      "!dist-obf/**",
      "!docs/**",
      "!arduino/**",
      "!api/**",
      "!**/*.map",
      "!**/README*",
      "!**/.git/**"
    ],
    "fileAssociations": [
      {
        "ext": "lss",
        "name": "LightScript Show",
        "description": "LightScript Show File",
        "role": "Editor"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "fileAssociations": [
        {
          "ext": "lss",
          "name": "LightScript Show",
          "role": "Editor"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "fileAssociations": [
        {
          "ext": "lss",
          "name": "LightScript Show",
          "description": "LightScript Show File"
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "keywords": [
    "lighting",
    "dmx",
    "console"
  ],
  "author": "LightScript",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}