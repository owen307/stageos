{
  "name": "booth-copilot",
  "version": "1.0.0",
  "description": "Booth Copilot — show control, OSC/MIDI, timecode automation",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.boothcopilot.app",
    "productName": "Booth Copilot",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "osc": "^2.4.4",
    "node-midi": "^4.0.0",
    "ws": "^8.18.0"
  }
}